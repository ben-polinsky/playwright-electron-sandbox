{
  "name": "playwright-electron-sandbox",
  "version": "0.1.0",
  "description": "Proof of concept Electron app with Playwright E2E tests runnable inside a Linux Docker container.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "xvfb-run -a npx playwright test",
    "test:headed": "xvfb-run -a PLAYWRIGHT_HEADLESS=0 npx playwright test"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "electron": "^28.3.3",
    "playwright": "^1.44.1"
  }
}
